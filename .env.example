# ── Database (separate components; URL is composed by settings.py) ──────
# Decision: no hardcoded credentials in code. The user
# explicitly controls user, password, host, port, and name.
DB_USER=postgres         # REQUIRED
DB_PASSWORD=postgres     # REQUIRED
DB_HOST=postgres         # REQUIRED — service name from docker-compose (change to "localhost" only if running the API OUTSIDE docker, e.g. `uv run uvicorn` on the host machine)
DB_PORT=5432             # REQUIRED (pydantic coerces to int)
DB_NAME=brain            # REQUIRED

# ── PII Database (separate database for pii_vault ──
# PII isolated from main database: backing up `brain` does not take PII along.
# Same postgres image, second database created via init script.
PII_DB_USER=postgres          # REQUIRED
PII_DB_PASSWORD=postgres      # REQUIRED
PII_DB_HOST=postgres          # REQUIRED (same service name; change to "localhost" if running API outside docker)
PII_DB_PORT=5432              # REQUIRED
PII_DB_NAME=pii               # REQUIRED

# ── LLM.chat (polarity verdict, reflections) ──────────────
# Supported providers: openai | openrouter | anthropic | gemini
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4-flash  # REQUIRED — no default in pydantic
# (optional) Automatic fallback if the primary fails
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=gpt-4o-mini

# ── Embedding ────────────────────────────────────────────────
# Supported providers: openai | openrouter | gemini
# (Anthropic has no native embeddings API)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small  # REQUIRED — no default in pydantic
# (optional) Automatic fallback
# EMBEDDING_FALLBACK_PROVIDER=openrouter
# EMBEDDING_FALLBACK_MODEL=text-embedding-3-small

# ── Key of the chosen provider (uncomment the one you'll use) ──
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# ── Security (secrets — REQUIRED, no default) ───────────
FERNET_KEY=<32-bytes-base64-key>  # REQUIRED — python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Rate Limits (sysadmin) ──────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Directories (sysadmin) ──────────────────────────────────
VAULT_MIRROR_PATH=/app/vault-mirror
BACKUP_PATH=/app/backups

# ── Budget (sysadmin) ───────────────────────────────────────
DAILY_TOKEN_BUDGET=100000
TOKEN_BUDGET_WARNING_RATIO=0.7
