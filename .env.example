# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cerebro
EMBEDDING_DIMENSIONS=1536

# LLM
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_TOTAL=15.0
LLM_TIMEOUT_CONNECT=5.0

# Security
FERNET_KEY=<32-bytes-base64-key>  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_PASSWORD=<pii-vault-pass>

# Rate Limits
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Directories
VAULT_MIRROR_PATH=/app/vault-mirror
BACKUP_PATH=/app/backups

# Budget
DAILY_TOKEN_BUDGET=100000
TOKEN_BUDGET_WARNING_RATIO=0.7
